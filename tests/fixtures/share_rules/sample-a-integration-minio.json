{
 "name": "dtt-capture",
 "networks": {
  "default": {
   "ipam": {},
   "name": "dtt-capture_default"
  }
 },
 "services": {
  "integration-minio": {
   "command": null,
   "cpus": 1,
   "entrypoint": null,
   "environment": {
    "AWS_ACCESS_KEY_ID": "fixture-password",
    "AWS_SECRET_ACCESS_KEY": "fixture-password"
   },
   "healthcheck": {
    "interval": "5s",
    "retries": 24,
    "test": [
     "CMD-SHELL",
     "curl -sS http://localhost:8333/ >/dev/null"
    ],
    "timeout": "5s"
   },
   "image": "chrislusf/seaweedfs:4.29@sha256:d47c7ee99fcb951351d7194915f4e3a5ea604a8e8871183d713907dec4fb9bf5",
   "mem_limit": "536870912",
   "networks": {
    "default": null
   },
   "ports": [
    {
     "host_ip": "127.0.0.1",
     "mode": "ingress",
     "protocol": "tcp",
     "target": 8333
    }
   ],
   "restart": "no",
   "tmpfs": [
    "/data"
   ]
  }
 }
}
