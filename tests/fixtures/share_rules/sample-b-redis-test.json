{
 "name": "dtt-capture",
 "networks": {
  "default": {
   "ipam": {},
   "name": "dtt-capture_default"
  }
 },
 "services": {
  "redis-test": {
   "command": null,
   "cpus": 1,
   "entrypoint": null,
   "healthcheck": {
    "interval": "1s",
    "retries": 30,
    "test": [
     "CMD",
     "redis-cli",
     "ping"
    ],
    "timeout": "1s"
   },
   "image": "redis:8.10.1-alpine@sha256:becdda6c7f4b3fb42e42fd7f120bbf5c54c4caaaf16f26da24e4563d2c1f0576",
   "mem_limit": "536870912",
   "networks": {
    "default": null
   },
   "ports": [
    {
     "host_ip": "127.0.0.1",
     "mode": "ingress",
     "protocol": "tcp",
     "target": 6379
    }
   ],
   "restart": "no",
   "tmpfs": [
    "/data"
   ]
  }
 }
}
