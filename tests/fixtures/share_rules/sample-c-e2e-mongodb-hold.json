{
 "name": "dtt-capture",
 "networks": {
  "authority": {
   "ipam": {},
   "name": "dtt-capture_authority"
  }
 },
 "services": {
  "keycloak": {
   "command": [
    "mkdir -p /opt/keycloak/data/import; cp /opt/keycloak/data/realm.json /opt/keycloak/data/import/realm.json; cp /opt/keycloak/data/realm-2.json /opt/keycloak/data/import/realm-2.json; exec /opt/keycloak/bin/kc.sh start-dev --import-realm"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 2,
      "memory": "1073741824"
     }
    }
   },
   "entrypoint": [
    "/bin/sh",
    "-ceu"
   ],
   "environment": {
    "JAVA_OPTS_KC_HEAP": "-Xms128m -Xmx1024m",
    "KC_BOOTSTRAP_ADMIN_PASSWORD": "fixture-password",
    "KC_BOOTSTRAP_ADMIN_USERNAME": "fixture-kc_bootstrap_admin_username",
    "KC_CLIENT_CERTIFICATE": "fixture-kc_client_certificate",
    "KC_FRONTEND_URL": "fixture-kc_frontend_url",
    "KC_PROXY_HEADERS": "fixture-kc_proxy_headers",
    "KC_REDIRECT_URI": "fixture-kc_redirect_uri",
    "KC_TEST_PASSWORD": "fixture-password",
    "KC_TEST_PASSWORD_R2": "fixture-password",
    "KC_TEST_PASSWORD_S2": "fixture-password"
   },
   "image": "fixture-sample_c_test_keycloak_image",
   "networks": {
    "authority": {
     "aliases": [
      "keycloak.test"
     ]
    }
   },
   "profiles": [
    "postgres",
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no"
  },
  "mongo1": {
   "command": [
    "install -o mongodb -g mongodb -m 400 /run/secrets/mongo-keyfile /tmp/mongo-keyfile; install -o mongodb -g mongodb -m 600 /run/secrets/mongo1.pem /tmp/mongo1.pem; install -o mongodb -g mongodb -m 644 /run/secrets/ca.crt /tmp/ca.crt; exec /usr/local/bin/docker-entrypoint.sh mongod --replSet authority --auth --tlsMode requireTLS --tlsCAFile /tmp/ca.crt --tlsCertificateKeyFile /tmp/mongo1.pem --tlsAllowConnectionsWithoutCertificates --keyFile /tmp/mongo-keyfile --setParameter enableTestCommands=1 --setParameter shutdownTimeoutMillisForSignaledShutdown=250"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 1,
      "memory": "805306368"
     }
    }
   },
   "entrypoint": [
    "/bin/sh",
    "-ceu"
   ],
   "image": "fixture-sample_c_test_mongo_image",
   "networks": {
    "authority": {
     "aliases": [
      "mongo1.test"
     ]
    }
   },
   "profiles": [
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no",
   "user": "0",
   "volumes": [
    {
     "source": "mongo1-data",
     "target": "/data/db",
     "type": "volume",
     "volume": {}
    }
   ]
  },
  "mongo2": {
   "command": [
    "install -o mongodb -g mongodb -m 400 /run/secrets/mongo-keyfile /tmp/mongo-keyfile; install -o mongodb -g mongodb -m 600 /run/secrets/mongo2.pem /tmp/mongo2.pem; install -o mongodb -g mongodb -m 644 /run/secrets/ca.crt /tmp/ca.crt; exec /usr/local/bin/docker-entrypoint.sh mongod --replSet authority --auth --tlsMode requireTLS --tlsCAFile /tmp/ca.crt --tlsCertificateKeyFile /tmp/mongo2.pem --tlsAllowConnectionsWithoutCertificates --keyFile /tmp/mongo-keyfile --setParameter enableTestCommands=1 --setParameter shutdownTimeoutMillisForSignaledShutdown=250"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 1,
      "memory": "805306368"
     }
    }
   },
   "entrypoint": [
    "/bin/sh",
    "-ceu"
   ],
   "image": "fixture-sample_c_test_mongo_image",
   "networks": {
    "authority": {
     "aliases": [
      "mongo2.test"
     ]
    }
   },
   "profiles": [
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no",
   "user": "0",
   "volumes": [
    {
     "source": "mongo2-data",
     "target": "/data/db",
     "type": "volume",
     "volume": {}
    }
   ]
  },
  "mongo3": {
   "command": [
    "install -o mongodb -g mongodb -m 400 /run/secrets/mongo-keyfile /tmp/mongo-keyfile; install -o mongodb -g mongodb -m 600 /run/secrets/mongo3.pem /tmp/mongo3.pem; install -o mongodb -g mongodb -m 644 /run/secrets/ca.crt /tmp/ca.crt; exec /usr/local/bin/docker-entrypoint.sh mongod --replSet authority --auth --tlsMode requireTLS --tlsCAFile /tmp/ca.crt --tlsCertificateKeyFile /tmp/mongo3.pem --tlsAllowConnectionsWithoutCertificates --keyFile /tmp/mongo-keyfile --setParameter enableTestCommands=1 --setParameter shutdownTimeoutMillisForSignaledShutdown=250"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 1,
      "memory": "805306368"
     }
    }
   },
   "entrypoint": [
    "/bin/sh",
    "-ceu"
   ],
   "image": "fixture-sample_c_test_mongo_image",
   "networks": {
    "authority": {
     "aliases": [
      "mongo3.test"
     ]
    }
   },
   "profiles": [
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no",
   "user": "0",
   "volumes": [
    {
     "source": "mongo3-data",
     "target": "/data/db",
     "type": "volume",
     "volume": {}
    }
   ]
  },
  "runtime": {
   "command": [
    "node",
    "dist/factories/browser.js"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 1,
      "memory": "268435456"
     }
    }
   },
   "entrypoint": null,
   "environment": {
    "BROWSER_ORIGIN": "https://runtime.test",
    "DATABASE_BACKEND": "fixture-database_backend",
    "DB_HOST": "127.0.0.1",
    "DB_HOSTS": "",
    "DB_NAME": "fixture-db_name",
    "DB_PASSWORD": "fixture-password",
    "DB_PORT": "5432",
    "DB_REPLICA_SET": "",
    "DB_TLS_CA": "fixture-db_tls_ca",
    "DB_TLS_MODE": "verify-full",
    "DB_USER": "fixture-db_user",
    "IDENTITY_PROVIDER": "auth0",
    "OIDC_CLIENT_AUTH": "client_secret_basic",
    "OIDC_CLIENT_ID": "synthetic-client",
    "OIDC_CLIENT_SECRET": "fixture-password",
    "OIDC_CONFIG_VERSION": "synthetic-v1",
    "OIDC_ISSUER": "https://identity.example/",
    "OIDC_REDIRECT_URI": "https://runtime.test/auth/callback",
    "SESSION_KEYS_JSON": "fixture-password",
    "SESSION_KEY_CURRENT": "fixture-password"
   },
   "image": "fixture-sample_c_test_runtime_image",
   "networks": {
    "authority": {
     "aliases": [
      "runtime.test"
     ]
    }
   },
   "profiles": [
    "postgres",
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no"
  },
  "test-client": {
   "command": [
    "tail",
    "-f",
    "/dev/null"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 2,
      "memory": "2147483648"
     }
    }
   },
   "entrypoint": null,
   "environment": {
    "DATABASE_BACKEND": "fixture-database_backend",
    "DB_HOST": "127.0.0.1",
    "DB_HOSTS": "",
    "DB_NAME": "fixture-db_name",
    "DB_PASSWORD": "fixture-password",
    "DB_PORT": "5432",
    "DB_REPLICA_SET": "",
    "DB_TLS_CA": "fixture-db_tls_ca",
    "DB_TLS_MODE": "verify-full",
    "DB_USER": "fixture-db_user",
    "LIFECYCLE_DB_PASSWORD": "fixture-password",
    "LIFECYCLE_DB_USER": "fixture-lifecycle_db_user",
    "MIGRATION_DB_PASSWORD": "fixture-password",
    "MIGRATION_DB_USER": "fixture-migration_db_user",
    "NODE_OPTIONS": "--max-old-space-size=1024"
   },
   "image": "fixture-sample_c_test_client_image",
   "networks": {
    "authority": null
   },
   "profiles": [
    "postgres",
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no",
   "volumes": [
    {
     "bind": {},
     "read_only": true,
     "source": "$CHECKOUT/tests",
     "target": "/app/tests",
     "type": "bind"
    }
   ]
  }
 },
 "volumes": {
  "mongo1-data": {
   "name": "dtt-capture_mongo1-data"
  },
  "mongo2-data": {
   "name": "dtt-capture_mongo2-data"
  },
  "mongo3-data": {
   "name": "dtt-capture_mongo3-data"
  }
 }
}
