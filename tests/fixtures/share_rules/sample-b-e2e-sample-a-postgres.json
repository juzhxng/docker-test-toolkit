{
 "name": "dtt-capture",
 "networks": {
  "default": {
   "ipam": {},
   "name": "dtt-capture_default"
  }
 },
 "services": {
  "e2e-sample-a-postgres": {
   "command": [
    "postgres",
    "-c",
    "shared_preload_libraries=pg_textsearch,pg_cron",
    "-c",
    "cron.database_name=sample-a"
   ],
   "cpus": 1,
   "entrypoint": null,
   "environment": {
    "POSTGRES_DB": "sample-a",
    "POSTGRES_PASSWORD": "fixture-password",
    "POSTGRES_USER": "sample-a"
   },
   "healthcheck": {
    "interval": "5s",
    "retries": 12,
    "test": [
     "CMD-SHELL",
     "pg_isready -U sample-a -d sample-a"
    ],
    "timeout": "5s"
   },
   "image": "sample-b-e2e-sample-a-postgres:00000000-0000-4000-8000-0000000000aa",
   "mem_limit": "536870912",
   "networks": {
    "default": null
   },
   "restart": "no"
  }
 }
}
