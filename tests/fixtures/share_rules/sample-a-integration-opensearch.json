{
 "name": "dtt-capture",
 "networks": {
  "default": {
   "ipam": {},
   "name": "dtt-capture_default"
  }
 },
 "services": {
  "integration-opensearch": {
   "command": null,
   "cpus": 1,
   "entrypoint": null,
   "environment": {
    "OPENSEARCH_INITIAL_ADMIN_PASSWORD": "fixture-password",
    "OPENSEARCH_JAVA_OPTS": "-Xms512m -Xmx512m",
    "bootstrap.memory_lock": "false",
    "discovery.type": "single-node"
   },
   "healthcheck": {
    "interval": "5s",
    "retries": 36,
    "start_period": "20s",
    "test": [
     "CMD-SHELL",
     "curl -ksSf https://localhost:9200/_cluster/health >/dev/null || exit 1"
    ],
    "timeout": "5s"
   },
   "image": "opensearchproject/opensearch:3.8.0@sha256:bcc1797519726ceb6d651d4a3e60b7c30da91793914a8dfe75fd441d4f641509",
   "mem_limit": "1610612736",
   "networks": {
    "default": null
   },
   "ports": [
    {
     "host_ip": "127.0.0.1",
     "mode": "ingress",
     "protocol": "tcp",
     "target": 9200
    }
   ],
   "restart": "no",
   "tmpfs": [
    "/usr/share/opensearch/data:rw,noexec,nosuid,size=1g,mode=0777"
   ]
  }
 }
}
