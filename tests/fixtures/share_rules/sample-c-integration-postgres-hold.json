{
 "name": "dtt-capture",
 "networks": {
  "authority": {
   "ipam": {},
   "name": "dtt-capture_authority"
  }
 },
 "services": {
  "postgres": {
   "command": [
    "bash",
    "-ceu",
    "install -o postgres -g postgres -m 600 /run/secrets/postgres.key /tmp/server.key; install -o postgres -g postgres -m 644 /run/secrets/postgres.crt /tmp/server.crt; exec docker-entrypoint.sh postgres -c ssl=on -c ssl_cert_file=/tmp/server.crt -c ssl_key_file=/tmp/server.key"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 1,
      "memory": "1073741824"
     }
    }
   },
   "entrypoint": null,
   "environment": {
    "POSTGRES_DB": "fixture",
    "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres-admin-password"
   },
   "image": "fixture-sample_c_test_postgres_image",
   "networks": {
    "authority": {
     "aliases": [
      "postgres.test"
     ]
    }
   },
   "profiles": [
    "postgres"
   ],
   "pull_policy": "never",
   "restart": "no",
   "volumes": [
    {
     "source": "postgres-data",
     "target": "/var/lib/postgresql",
     "type": "volume",
     "volume": {}
    }
   ]
  },
  "test-client": {
   "command": [
    "tail",
    "-f",
    "/dev/null"
   ],
   "deploy": {
    "placement": {},
    "resources": {
     "limits": {
      "cpus": 2,
      "memory": "2147483648"
     }
    }
   },
   "entrypoint": null,
   "environment": {
    "DATABASE_BACKEND": "fixture-database_backend",
    "DB_HOST": "127.0.0.1",
    "DB_HOSTS": "",
    "DB_NAME": "fixture-db_name",
    "DB_PASSWORD": "fixture-password",
    "DB_PORT": "5432",
    "DB_REPLICA_SET": "",
    "DB_TLS_CA": "fixture-db_tls_ca",
    "DB_TLS_MODE": "verify-full",
    "DB_USER": "fixture-db_user",
    "LIFECYCLE_DB_PASSWORD": "fixture-password",
    "LIFECYCLE_DB_USER": "fixture-lifecycle_db_user",
    "MIGRATION_DB_PASSWORD": "fixture-password",
    "MIGRATION_DB_USER": "fixture-migration_db_user",
    "NODE_OPTIONS": "--max-old-space-size=1024"
   },
   "image": "fixture-sample_c_test_client_image",
   "networks": {
    "authority": null
   },
   "profiles": [
    "postgres",
    "mongodb"
   ],
   "pull_policy": "never",
   "restart": "no",
   "volumes": [
    {
     "bind": {},
     "read_only": true,
     "source": "$CHECKOUT/src",
     "target": "/app/src",
     "type": "bind"
    },
    {
     "bind": {},
     "read_only": true,
     "source": "$CHECKOUT/tests",
     "target": "/app/tests",
     "type": "bind"
    }
   ]
  }
 },
 "volumes": {
  "postgres-data": {
   "name": "dtt-capture_postgres-data"
  }
 }
}
